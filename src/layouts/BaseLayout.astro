---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieNotice from "../components/CookieNotice.astro";
import Lightbox from "../components/Lightbox.astro";
import { site } from "../lib/cms";

interface Props {
  title: string;
  description?: string;
  pageTitle?: string;
  overlay?: boolean;
}

const { title, description, pageTitle } = Astro.props;
const current = Astro.url.pathname;
const accentTitle = (pageTitle || "")
  .replaceAll("TRG", 'T<span class="text-coral">R</span>G')
  .replaceAll("Golf Day", '<span class="text-coral">Golf Day</span>')
  .replaceAll("Community", '<span class="text-coral">Community</span>');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || "Toowoomba Referral Group is a business networking community."} />
    <link rel="icon" href={site.favicon || "/favicon.ico"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Roboto+Slab:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <Header current={current} />
      {
        pageTitle && (
          <div class="bg-sky/40 px-4 py-6 text-center">
            <h1 class="text-4xl text-navy md:text-5xl" set:html={accentTitle} />
          </div>
        )
      }
    </header>
    <main>
      <slot />
    </main>
    <Footer />
    <CookieNotice />
    <Lightbox />
  </body>
</html>
