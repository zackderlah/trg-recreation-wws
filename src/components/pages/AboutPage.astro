---
const { page } = Astro.props;
---

<img src={page.hero} alt="About TRG Business Networking" class="h-[250px] w-full object-cover object-[center_63%] md:h-[600px]" />

<section class="bg-sky/40 px-4 py-6 text-center">
  <h1 class="text-4xl text-navy md:text-5xl">About T<span class="text-coral">R</span>G</h1>
</section>

<section class="bg-white px-4 py-10 text-navy">
  <div class="mx-auto grid max-w-5xl gap-12 md:grid-cols-2 md:gap-16">
  <div>
    <h2 class="text-2xl text-navy">What We Do</h2>
    <p class="mt-4 text-[15px] leading-relaxed">{page.body[0]}</p>
    <a class="btn-coral mt-6" href="/contact">Contact Us</a>
  </div>
  <div>
    <h2 class="text-2xl text-navy">What's Involved?</h2>
    <p class="mt-4 text-[15px] leading-relaxed">{page.body[1]}</p>
    <p class="mt-4 text-[15px] leading-relaxed">{page.body[2]}</p>
    </div>
  </div>
</section>

<section class="bg-[#eef6fb] px-4 py-12">
  <h2 class="text-center text-3xl text-coral">Meet Our 2026 Committee</h2>
  <div class="mx-auto mt-10 grid max-w-5xl gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      page.committee.map((person: { name: string; role: string; org: string; image: string; alt: string }) => (
        <article class="text-center">
          <div class="bg-slate-200">
            <div class="h-2 bg-coral"></div>
            {person.image && (
              <a class="gallery-thumb gallery-thumb-portrait" href={person.image} data-lightbox={person.image} data-alt={person.alt || person.name}>
                <img src={person.image} alt={person.alt || person.name} />
              </a>
            )}
          </div>
          <h3 class="mt-3 text-lg font-bold text-navy">{person.name}</h3>
          <p class="text-sm">{person.role}</p>
          <p class="text-sm">{person.org}</p>
        </article>
      ))
    }
  </div>
</section>
