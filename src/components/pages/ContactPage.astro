---
const { page } = Astro.props;
---

<section class="bg-sky/40 px-4 py-6 text-center">
  <h1 class="text-4xl text-navy md:text-5xl">Contact T<span class="text-coral">R</span>G</h1>
</section>

<section class="flex flex-col bg-white text-navy lg:flex-row">
  <div class="flex-1 px-6 py-10 md:px-12">
    <h2 class="text-3xl text-navy">Committee Contacts</h2>
    <div class="mt-8 space-y-6">
      {
        page.contacts.map((person: { role: string; note?: string; name: string; phone: string; phoneHref: string }) => (
          <article>
            <h3 class="text-xl">{person.role}</h3>
            {person.note && <p class="text-sm">{person.note}</p>}
            <p class="mt-2">{person.name}</p>
            <p>
              Phone: <a class="text-sky-600 underline" href={person.phoneHref}>{person.phone}</a>
            </p>
          </article>
        ))
      }
    </div>
  </div>
  <div class="flex-1 bg-white px-6 py-10 text-navy md:px-12">
    <h2 class="text-3xl text-navy">Email Us</h2>
    <form class="mt-6 space-y-4" method="post" action="/contact">
      <label class="block text-sm">Business Name*
        <input class="mt-1 w-full border border-slate-300 bg-[#f5f5f5] px-3 py-2 text-navy placeholder:text-slate-500" name="business" required placeholder="Required" />
      </label>
      <label class="block text-sm">What Type of Business are you in?
        <input class="mt-1 w-full border border-slate-300 bg-[#f5f5f5] px-3 py-2 text-navy placeholder:text-slate-500" name="type" required placeholder="Required" />
      </label>
      <label class="block text-sm">Name*
        <input class="mt-1 w-full border border-slate-300 bg-[#f5f5f5] px-3 py-2 text-navy placeholder:text-slate-500" name="name" required placeholder="Required" />
      </label>
      <label class="block text-sm">Contact Phone*
        <input class="mt-1 w-full border border-slate-300 bg-[#f5f5f5] px-3 py-2 text-navy placeholder:text-slate-500" name="phone" required placeholder="Required" />
      </label>
      <label class="block text-sm">Email*
        <input class="mt-1 w-full border border-slate-300 bg-[#f5f5f5] px-3 py-2 text-navy placeholder:text-slate-500" type="email" name="email" required placeholder="Required" />
      </label>
      <label class="block text-sm">Comments and Questions
        <textarea class="mt-1 h-28 w-full border border-slate-300 bg-[#f5f5f5] px-3 py-2 text-navy" name="comments"></textarea>
      </label>
      <p class="text-sm leading-6">
        This form matches the original enquiry fields. The WebWave mailbox was not published with a recipient address, so please call a committee member to reach TRG directly.
      </p>
      <button class="cursor-pointer bg-sky px-6 py-2 text-white transition-colors hover:bg-[#3a90c9]" type="submit">Send</button>
    </form>
  </div>
</section>
