---
import { cms } from "../../lib/content";
const pageSize = 24;
---

<section class="bg-white px-4 py-10">
  <div id="member-grid" class="mx-auto grid max-w-6xl grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5"></div>
  <div class="mt-8 flex items-center justify-center">
    <button class="member-pager-btn" id="member-prev" type="button" aria-label="Previous page">&lt;</button>
    <span id="member-pages" class="flex items-center"></span>
    <button class="member-pager-btn" id="member-next" type="button" aria-label="Next page">&gt;</button>
  </div>
</section>

<script define:vars={{ directory: cms.directory, pageSize }}>
  const grid = document.querySelector("#member-grid");
  const pages = document.querySelector("#member-pages");
  let page = 0;
  const total = Math.ceil(directory.length / pageSize);

  function render() {
    const slice = directory.slice(page * pageSize, page * pageSize + pageSize);
    if (!grid) return;
    grid.innerHTML = slice
      .map(
        (member) => `
        <a class="member-card" href="${member.href}">
          <img src="${member.image || ""}" alt="" class="mx-auto h-24 w-full object-contain" />
          <p class="mt-3 text-sm">${member.title}</p>
          <p class="text-sm text-sky-600">Member Details</p>
        </a>`
      )
      .join("");
    if (pages) {
      pages.innerHTML = Array.from({ length: total }, (_, i) => `<button type="button" data-page="${i}" class="member-pager-btn${i === page ? " is-current" : ""}">${i + 1}</button>`).join("");
    }
  }

  document.querySelector("#member-prev")?.addEventListener("click", () => {
    page = Math.max(0, page - 1);
    render();
  });
  document.querySelector("#member-next")?.addEventListener("click", () => {
    page = Math.min(total - 1, page + 1);
    render();
  });
  pages?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    page = Number(target.dataset.page || 0);
    render();
  });
  render();
</script>
