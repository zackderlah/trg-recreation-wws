---
const { page } = Astro.props;
const items = page.groups?.[0]?.items || [];
---

<section class="bg-white px-4 py-10">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
    {
      items.map((member: { title: string; href: string; image?: string }) => (
        <a class="member-card" href={member.href}>
          {member.image && <img src={member.image} alt={member.title} class="mx-auto h-24 w-full object-contain" />}
          <p class="mt-3 text-sm">{member.title}</p>
          <p class="text-sm text-sky-600">Member Details</p>
        </a>
      ))
    }
  </div>
</section>
