---
import { cms } from "../../lib/content";
const pageSize = 24;
---

<section>
  <div id="member-band" class="bg-charcoal px-4 pb-8 pt-2">
    <div id="member-top" class="mx-auto grid max-w-6xl grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5"></div>
  </div>
  <div class="bg-white px-4 py-8">
    <div id="member-rest" class="mx-auto grid max-w-6xl grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5"></div>
  </div>
  <div class="mt-8 flex items-center justify-center gap-4 text-coral">
    <button id="member-prev" type="button" aria-label="Previous page">&lt;</button>
    <span id="member-pages" class="flex gap-3"></span>
    <button id="member-next" type="button" aria-label="Next page">&gt;</button>
  </div>
</section>

<script define:vars={{ directory: cms.directory, pageSize }}>
  const top = document.querySelector("#member-top");
  const rest = document.querySelector("#member-rest");
  const band = document.querySelector("#member-band");
  const pages = document.querySelector("#member-pages");
  let page = 0;
  const total = Math.ceil(directory.length / pageSize);

  function card(member, onCharcoal) {
    const text = onCharcoal ? "text-white" : "text-navy";
    const shell = onCharcoal ? "bg-charcoal text-white" : "border bg-white text-navy shadow-sm";
    return `
      <a class="block p-3 text-center ${shell}" href="${member.href}">
        <img src="${member.image || ""}" alt="" class="mx-auto h-24 w-full object-contain" />
        <p class="mt-3 text-sm ${text}">${member.title}</p>
        <p class="text-sm text-sky-400">Member Details</p>
      </a>`;
  }

  function render() {
    const slice = directory.slice(page * pageSize, page * pageSize + pageSize);
    const split = page === 0 ? 10 : 0;
    if (band) band.classList.toggle("hidden", split === 0);
    top.innerHTML = slice.slice(0, split).map((member) => card(member, true)).join("");
    rest.innerHTML = slice.slice(split).map((member) => card(member, false)).join("");
    pages.innerHTML = Array.from({ length: total }, (_, i) => `<button type="button" data-page="${i}" class="${i === page ? "font-bold text-navy" : ""}">${i + 1}</button>`).join("");
  }

  document.querySelector("#member-prev")?.addEventListener("click", () => {
    page = Math.max(0, page - 1);
    render();
  });
  document.querySelector("#member-next")?.addEventListener("click", () => {
    page = Math.min(total - 1, page + 1);
    render();
  });
  pages?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    page = Number(target.dataset.page || 0);
    render();
  });
  render();
</script>
