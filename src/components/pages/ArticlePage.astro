---
const { page } = Astro.props;
const blocks = page.blocks || [];
---

{page.image && (
  <div class="bg-white px-4 py-8">
    <img src={page.image} alt={page.heading} class="mx-auto max-h-[420px] w-full max-w-4xl object-cover" />
  </div>
)}

<article class="mx-auto max-w-3xl px-4 py-10">
  <h2 class="text-4xl text-navy">{page.heading}</h2>
  {page.date && <p class="mt-3 text-sm font-bold">{page.date}</p>}
  <div class="prose-copy mt-6">
    {
      blocks.map((block: { type: string; text?: string; items?: string[] }) => {
        if (block.type === "heading") return <h3 class="text-2xl text-navy">{block.text}</h3>;
        if (block.type === "list") {
          return (
            <ul>
              {(block.items || []).map((item) => (
                <li class="ml-5 list-disc">{item}</li>
              ))}
            </ul>
          );
        }
        return <p>{block.text}</p>;
      })
    }
  </div>
  {
    (page.links || []).length > 0 && (
      <p class="mt-6">
        {page.links.map((link: { href: string; text: string }) => (
          <a class="mr-4 text-sky-700 underline" href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
            {link.text}
          </a>
        ))}
      </p>
    )
  }
  <a class="btn-coral mt-8" href="/news">back to news list</a>
</article>
