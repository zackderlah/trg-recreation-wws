---
const { page } = Astro.props;
const raffle = page.raffle;
const event = page.event;
---

<section class="bg-sky/40 px-4 py-6 text-center">
  <h1 class="text-4xl text-navy md:text-5xl">T<span class="text-coral">R</span>G Annual <span class="text-coral">Golf Day</span></h1>
</section>

<section class="bg-white px-4 py-10 text-navy">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-10 md:flex-row">
    {page.banner && <img src={page.banner} alt="TRG Annual Charity Golf Day" class="w-full object-cover md:w-1/2" />}
    <div class="space-y-4 leading-relaxed">
      {page.intro.map((paragraph: string) => <p>{paragraph}</p>)}
      <a class="btn-coral mt-4" href={page.registerHref} target="_blank" rel="noreferrer">Register Your Interest</a>
    </div>
  </div>
</section>

<section class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-4 py-10 md:flex-row">
  <img src={raffle.image} alt="Win $5000 cash in the TRG Golf Day raffle" class="w-full md:w-1/2" />
  <div>
    <h2 class="text-3xl text-navy">T<span class="text-coral">R</span>G 2026 Charity <span class="text-coral">Golf Day</span> Major Prize</h2>
    <p class="mt-4">{raffle.body}</p>
    <a class="btn-coral mt-5" href={raffle.cta.href} target="_blank" rel="noreferrer">{raffle.cta.label}</a>
  </div>
</section>

<section class="mx-auto max-w-3xl px-4 py-6 text-center">
  <div class="border border-slate-200 p-6">
    <h2 class="text-3xl text-navy">Sponsorships and Donations</h2>
    <ul class="mt-4 space-y-1 text-sm leading-7">
      {page.sponsorships.map((item: string) => <li>{item}</li>)}
    </ul>
    <a class="btn-coral mt-5" href={page.registerHref} target="_blank" rel="noreferrer">Register Your Interest</a>
  </div>
  <div class="mt-8 border border-slate-200 p-6">
    <h2 class="text-3xl text-navy">{event.heading}</h2>
    <p class="mt-3 font-bold">{event.date}</p>
    <p class="mt-2">{event.venue}<br />{event.address}</p>
    <p class="mt-2">{event.registration}<br />{event.teeOff}</p>
  </div>
</section>

<section class="mx-auto max-w-5xl px-4 py-10">
  <h2 class="text-center text-3xl text-navy">2026 Charities</h2>
  <div class="mt-8 flex flex-col gap-6 md:flex-row">
    {page.charities.map((charity: { name: string; image: string; body: string; href: string }) => (
      <article class="flex-1 border border-slate-200 p-6 text-center">
        {charity.image && <img src={charity.image} alt={charity.name} class="mx-auto h-24 object-contain" />}
        <p class="mt-4 text-sm leading-6">{charity.body}</p>
        <a class="btn-coral mt-4" href={charity.href} target="_blank" rel="noreferrer">Learn More</a>
      </article>
    ))}
  </div>
</section>

<section class="px-4 py-10">
  <h2 class="text-center text-3xl text-navy">2026 Sponsors</h2>
  <div class="mx-auto mt-6 flex max-w-5xl flex-col gap-4 md:flex-row">
    <div class="flex-1 bg-[#a2c9e6] px-4 py-8 text-center text-navy">
      <h3 class="text-xl font-bold">Major Sponsors</h3>
      <ul class="mt-4 space-y-1 text-sm">
        {page.sponsors.major.map((name: string) => <li>{name}</li>)}
      </ul>
    </div>
    <div class="flex-1 bg-coral px-4 py-8 text-center text-white">
      <h3 class="text-xl font-bold">Hole Sponsors</h3>
      <ul class="mt-4 space-y-1 text-sm">
        {page.sponsors.hole.map((name: string) => <li>{name}</li>)}
      </ul>
    </div>
    <div class="flex-1 bg-[#f5f5f5] px-4 py-8 text-center text-navy">
      <h3 class="text-xl font-bold">Other Sponsors</h3>
      <ul class="mt-4 space-y-1 text-sm">
        {page.sponsors.other.map((name: string) => <li>{name}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="mx-auto max-w-5xl px-4 py-10">
  <h2 class="text-center text-3xl text-navy">Past Charities</h2>
  <div class="mt-6 flex flex-wrap items-center justify-center gap-10">
    {page.pastCharities.map((image: { src: string; alt: string }) => (
      <img src={image.src} alt={image.alt} class="h-20 object-contain" />
    ))}
  </div>
  <h2 class="mt-10 text-center text-3xl text-navy">Golf Day Galleries</h2>
  <h3 class="mt-6 text-center text-xl font-bold">2025</h3>
  <div class="mt-4 flex flex-wrap gap-3">
    {
      page.galleries["2025"].map((src: string) => (
        <a class="gallery-thumb w-[48%] md:w-[23%]" href={src}>
          <img src={src} alt="TRG Charity Golf Day 2025" />
        </a>
      ))
    }
  </div>
  <h3 class="mt-8 text-center text-xl font-bold">2024</h3>
  <div class="mt-4 flex flex-wrap gap-3">
    {
      page.galleries["2024"].map((src: string) => (
        <a class="gallery-thumb w-[48%] md:w-[23%]" href={src}>
          <img src={src} alt="TRG Charity Golf Day 2024" />
        </a>
      ))
    }
  </div>
</section>
