---
import { site } from "../lib/cms";
---

<section class="flex flex-wrap items-center justify-between gap-4 bg-white px-4 py-2 md:min-h-[100px] md:px-8">
  <a href="/" class="shrink-0">
    <img src={site.logo} alt="Toowoomba Business Referral Group Logo" class="h-14 w-auto object-contain md:h-16" />
  </a>
  <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1" aria-label="Primary">
    {site.nav.map((item) => (
      <a class="nav-link" href={item.href}>{item.label}</a>
    ))}
    <a class="nav-link" href={site.facebook} target="_blank" rel="noreferrer">Facebook</a>
  </nav>
  <a
    href={site.facebook}
    class="inline-flex h-10 w-10 items-center justify-center rounded-sm bg-[#1877f2]"
    aria-label="TRG Facebook"
    target="_blank"
    rel="noreferrer"
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5 fill-white" aria-hidden="true">
      <path d="M14.5 8.5V6.8c0-.7.5-1 1.2-1H17V3h-2.1C12.2 3 11 4.4 11 6.6v1.9H9v2.8h2V21h3.5v-9.7h2.3l.4-2.8h-2.7z"></path>
    </svg>
  </a>
</section>
