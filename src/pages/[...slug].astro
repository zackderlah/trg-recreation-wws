---
import BaseLayout from "../layouts/BaseLayout.astro";
import MemberPage from "../components/pages/MemberPage.astro";
import ArticlePage from "../components/pages/ArticlePage.astro";
import { pages } from "../lib/cms";

export function getStaticPaths() {
  return Object.entries(pages)
    .filter(([, page]) => page.type === "product" || page.type === "blog-post")
    .map(([path, page]) => ({
      params: { slug: path.replace(/^\//, "") },
      props: { page }
    }));
}

const { page } = Astro.props;
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  {page.type === "product" && <MemberPage page={page} />}
  {page.type === "blog-post" && <ArticlePage page={page} />}
</BaseLayout>
